{
  "schema_version": "stegverse.org-resident-runtime.activation.v1",
  "organization": "StegVerse-002",
  "canonical_repository": "StegVerse-002/.github",
  "activation_owner": "StegVerse-002/.github",
  "entrypoint": "resident-runtime/resident_executor.py",
  "ingress_egress_owner": "StegVerse-002/.github",
  "intr_transport": "org-boundary/runtime/intr_transport.py",
  "boundary_processor": "org-boundary/runtime/process_boundary.py",
  "state": "UNIVERSAL_KERNEL_NETWORK_FEDERATION_SOURCE_INSTALLED_OBSERVATION_PENDING",
  "github_actions_is_runtime_authority": false,
  "hb_carrier_grants_authority": false,
  "application_repositories_are_activation_authority": false,
  "kernel": {
    "version": "1.3.1",
    "path": "org-kernel/kernel.py",
    "canonical_source": "StegVerse-Labs/.github/org-kernel",
    "vendored": true
  },
  "ecosystem_control": "resident-runtime/ecosystem_control.py",
  "federation_cycle": "resident-runtime/federation_cycle.py",
  "federation_directory": "org-boundary/registry/federation.json",
  "federation_gateway_transport": "resident-runtime/federation_gateway_transport.py",
  "federation_gateway_url_env": "STEGVERSE_ORG_FEDERATION_GATEWAY_URL",
  "federation_gateway_required_for_cross_host": true,
  "local_spool_scope": "SAME_HOST_FALLBACK_ONLY",
  "resident_cycle_entrypoint": "resident-runtime/resident_executor.py",
  "federation_poll_mode": "CONTINUOUS_BIDIRECTIONAL",
  "federation_network_route": "SHARED_SERVICE_GATEWAY",
  "self_characterization_surface": {
    "state": "SOURCE_INSTALLED",
    "implementation": "resident-runtime/self_characterization_surface.py",
    "binding": "resident-runtime/self-characterization/stegverse-002.json",
    "service_id": "stegverse-002.self-characterization",
    "principal_repository": "StegVerse-002/micro-node-runtime",
    "cross_organization_principal_execution_allowed": false,
    "master_records_required": true,
    "callable_task_id": "STEGVERSE-002-EXPERIMENT-RERUN-001",
    "callable_operation": "REQUEST_SELF_CHARACTERIZATION",
    "callable_publisher_binding": "resident-runtime/invoke_sv002_experiment_rerun.py",
    "callable_invocation_count": 1,
    "publisher_semantics": "EXISTING_ORG_KERNEL_FRAME_OR_SHARED_SERVICE_GATEWAY_ONLY"
  },
  "persistent_executor": {
    "state": "SOURCE_INSTALLED_ACTIVATION_EVIDENCE_PENDING",
    "implementation": "resident-runtime/resident_executor.py",
    "restart_policy": "ALWAYS",
    "service_template": "resident-runtime/systemd/stegverse-002-resident.service",
    "github_actions_runtime_authority": "NONE"
  },
  "hb_epoch_bindings": {
    "resident-runtime/federation_cycle.py": {
      "requires_hb_epoch": true,
      "from": "dispatch_input",
      "input": "hb_epoch",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "argument": "--hb-epoch",
      "supplied_by": ".github/workflows/resident-federation-cycle.yml"
    },
    "resident-runtime/resident_executor.py": {
      "requires_hb_epoch": true,
      "reason": "runs resident-runtime/federation_cycle.py each cycle",
      "from": "dispatch_input",
      "input": "hb_epoch",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "reached_from": "resident-runtime/federation_cycle.py",
      "supplied_by": ".github/workflows/resident-federation-cycle.yml",
      "runtime_substrate": "PENDING_WU_B13",
      "optional_consumer": "resident-runtime/systemd/stegverse-002-resident.service (STEGVERSE_HB_EPOCH, if its host provides one); not the binding"
    },
    "resident-runtime/federation_gateway_transport.py": {
      "requires_hb_epoch": true,
      "from": "argument",
      "argument": "hb_epoch=",
      "supplied_by": "resident-runtime/federation_cycle.py::cycle",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "reached_from": "resident-runtime/federation_cycle.py"
    },
    "org-boundary/runtime/process_boundary.py": {
      "requires_hb_epoch": true,
      "from": "argument",
      "argument": "--hb-epoch",
      "supplied_by": "org-kernel/kernel.py::dispatch",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "reached_from": "resident-runtime/federation_cycle.py"
    },
    "org-kernel/kernel.py": {
      "requires_hb_epoch": true,
      "from": "frame_heartbeat",
      "rule": "org-kernel/kernel.py::consuming_epoch",
      "supplied_by": "org-kernel/kernel.py::ingest_frame",
      "fallback": "the caller's hb_epoch= (a cycle's epoch) for a frame that lends none",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "reached_from": "resident-runtime/federation_cycle.py"
    },
    "resident-runtime/ecosystem_control.py": {
      "requires_hb_epoch": true,
      "reason": "status stamps the status heartbeat and send-monitor/send-work/send-message stamp the frames they publish; collect only reads and takes none",
      "from": "dispatch_input",
      "input": "hb_epoch",
      "dispatcher": ".github/workflows/resident-federation-cycle.yml",
      "argument": "--hb-epoch",
      "supplied_by": ".github/workflows/resident-federation-cycle.yml",
      "invoked_as": "--hb-epoch \"$HB_EPOCH\" status",
      "epoch_free_commands": ["collect"]
    }
  }
}
