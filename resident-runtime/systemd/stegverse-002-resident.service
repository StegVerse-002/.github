[Unit]
Description=StegVerse-002 resident executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/stegverse/source/StegVerse-002/.github
ExecStart=/usr/bin/python3 /var/lib/stegverse/source/StegVerse-002/.github/resident-runtime/resident_executor.py --poll-seconds 1
Restart=always
RestartSec=1
# An optional consumer of the resident cycle's epoch, not its binding: the
# in-tree dispatcher is .github/workflows/resident-federation-cycle.yml (see
# activation-manifest.json hb_epoch_bindings). Without STEGVERSE_HB_EPOCH each
# cycle refuses six-field HB_EPOCH_NOT_SUPPLIED; no clock stands in.
EnvironmentFile=-/etc/stegverse/resident.env

[Install]
WantedBy=multi-user.target
